=> SortedSet Interface Methods

     -> SortedSet (I)
          -> extends SequencedSet (I)

     -> Comparator Operation
          -> comparator()

     -> Range View Operations
          -> subSet(E fromElement, E toElement)
          -> headSet(E toElement)
          -> tailSet(E fromElement)

     -> Boundary Element Operations
          -> first()
          -> last()

     -> Important Point

          -> SortedSet stores elements according to sorting order.

          -> Sorting can be based on:

               -> Natural Ordering
                    Example:
                    Integer
                    String

               -> Custom Comparator

          -> SortedSet = Unique Elements + Sorted Order

