     -> Last-End Insert Operations

          -> addLast(E e)
          -> offerLast(E e)


     -> First-End Remove Operations

          -> removeFirst()
          -> pollFirst()


     -> Last-End Remove Operations

          -> removeLast()
          -> pollLast()


     -> First-End Examine Operations

          -> getFirst()
          -> peekFirst()


     -> Last-End Examine Operations

          -> getLast()
          -> peekLast()


     -> Queue-Style Operations

          -> add(E e)
          -> offer(E e)

          -> remove()
          -> poll()

          -> element()
          -> peek()


     -> Stack-Style Operations

          -> push(E e)
          -> pop()


     -> Occurrence Removal Operations

          -> removeFirstOccurrence(Object o)
          -> removeLastOccurrence(Object o)


     -> Reverse Iteration Operation

          -> descendingIterator()

